[run]
branch = True
relative_files = True
source =
    display
    models
    peloton
    scripts
    self_update
    settings_page
    utils
    peloton_led
omit =
    driver/*
    version.py

[report]
skip_empty = True
# CI fails below this; raise it as coverage grows, never lower it to pass.
fail_under = 90
