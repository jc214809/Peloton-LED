{
  "debug": false,
  "matrix": {
    "rows": 64,
    "cols": 64,
    "gpio_mapping": null,
    "brightness": 100
  },
  "display": {
    "username": "Peloton Member",
    "font": "stats",
    "color": "white",
    "duration": 4,
    "overview_duration": 4,
    "last_workout_detail_interval": 4,
    "workout_insights": false,
    "logo_duration": 5,
    "timezone": "America/New_York",
    "refresh_interval": 300,
    "history_batch_size": 100,
    "recent_fetch_size": 20,
    "performance_cache_size": 32,
    "cache_path": "dashboard-cache.json",
    "rotation": [
      "latest_workouts",
      "username",
      "total_workouts",
      "next_milestone",
      "lifetime",
      "milestones",
      "goals"
    ],
    "screen_durations": {
      "username": 5,
      "lifetime": 5,
      "milestones": 5.8,
      "goals": 4
    },
    "weekly_goals": {
      "workouts": 0,
      "minutes": 0,
      "active_days": 0
    },
    "milestones": [],
    "milestone_step": 100,
    "milestone_within": 5,
    "milestone_pages": 3,
    "brightness_schedule": null,
    "refresh_schedule": null
  }
}
