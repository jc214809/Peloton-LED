# Local development credentials for scripts/refresh_cookies.py.
# Copy this file to .env and fill in real values — .env is gitignored.
#
# Single-user setup (no "users" array in config.json):
PELOTON_EMAIL=you@example.com
PELOTON_PASSWORD=your-password

# Dual-user setup: name the vars from each user's email_env/password_env
# in config.json (see config.dual-users-example.json).
PELOTON_EMAIL_RIDER_ONE=first@example.com
PELOTON_PASSWORD_RIDER_ONE=first-password
PELOTON_EMAIL_RIDER_TWO=second@example.com
PELOTON_PASSWORD_RIDER_TWO=second-password
